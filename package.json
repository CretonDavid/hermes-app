    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/material-date-fns-adapter": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@fontsource-variable/nunito": "^5.3.0",
    "chart.js": "^4.6.1",
    "date-fns": "^4.4.0",
    "material-symbols": "^0.48.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
